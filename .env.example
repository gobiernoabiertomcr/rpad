# Copiar a .env y completar. Los valores de ejemplo son para desarrollo local con docker-compose.yml

# Servidor
PORT=3001
CORS_ORIGIN=http://localhost:3001

# Base de datos (contenedor rpad-db; 3307 para no chocar con un MySQL local en 3306)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=datospublicos_mcr_rpad
DB_USER=rpad
DB_PASSWORD=cambiar
DB_ROOT_PASSWORD=cambiar

# Seguridad (generar valores largos y aleatorios)
JWT_SECRET=cambiar
CRON_SECRET=cambiar

# SMTP: en local apunta a Mailpit, que captura todos los emails (http://localhost:8025).
# NUNCA poner el SMTP real en desarrollo: la base real tiene emails reales de áreas.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=rpad-local@localhost
SMTP_PASS=local

# Barrera de destinatarios (SOLO desarrollo): con una lista de direcciones separadas por coma, todo email del
# sistema se envía solo a esas casillas y el resto de los destinatarios se descarta. En producción no se define.
# EMAIL_SOLO_A=

# Tests automáticos (npm test): crean y borran usuarios y datasets de prueba.
# Descomentar SOLO en la base local de Docker. NUNCA en producción.
# RPAD_TESTS_DB_LOCAL=1
